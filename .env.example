# --- Database ---
# Local Postgres example: postgresql://user:password@localhost:5432/event_platform
DATABASE_URL="postgresql://user:password@localhost:5432/event_platform"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- GitHub OAuth ---
# https://github.com/settings/developers
# Authorization callback URL: https://your-domain.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Stripe (TEST MODE keys, both start with sk_test_ / pk_test_) ---
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxx"
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxx"

# Price of the workshop ticket, in the smallest currency unit (e.g. cents)
WORKSHOP_PRICE_CENTS=4900
WORKSHOP_CURRENCY="usd"
WORKSHOP_NAME="Advanced React Workshop"

# --- Email (Resend) ---
# https://resend.com/api-keys — free tier is enough for testing
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Workshop Team <onboarding@resend.dev>"
